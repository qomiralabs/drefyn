{
  "name": "drefyn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --max-warnings 0 eslint.config.js vitest.shared.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "build": "turbo run build",
    "hygiene": "node scripts/hygiene/src/cli.ts",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
