{
  "name": "drefyn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --max-warnings 0 eslint.config.js vitest.shared.ts",
    "lint:guard": "bash scripts/lint-rules/guard.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "build": "turbo run build",
    "hygiene": "node scripts/hygiene/src/cli.ts",
    "check:packages": "node scripts/lint-rules/src/check-packages.ts",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@drefyn/lint-rules": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
