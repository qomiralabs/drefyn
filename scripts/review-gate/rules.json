{
  "reviewers": {
    "code-reviewer": ["Divine572"],
    "qa-verifier": ["Divine572"],
    "security-reviewer": ["Divine572"],
    "performance-reviewer": ["Divine572"],
    "design-reviewer": ["Divine572"]
  },
  "paths": {
    "security": {
      "prefixes": [
        ".github/",
        "scripts/",
        "deploy/",
        "docker/",
        ".changeset/",
        "packages/egress/",
        "packages/flags/",
        "packages/address/",
        "packages/db/migrations/",
        ".husky/",
        ".githooks/"
      ],
      "names": [
        "renovate.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "SECURITY.md",
        ".npmrc",
        ".nvmrc",
        ".pnpmfile.cjs",
        "turbo.json",
        "eslint.config.js",
        "eslint.config.mjs",
        "eslint.config.cjs",
        "eslint.config.ts",
        "eslint.config.mts",
        "eslint.config.cts",
        "guard.config.js",
        ".gitmodules",
        ".gitattributes",
        ".gitignore",
        "LICENSE",
        "vitest.shared.ts",
        ".prettierrc.json",
        ".prettierignore",
        "Dockerfile",
        ".dockerignore",
        ".gitleaks.toml",
        ".gitleaksignore",
        "osv-scanner.toml",
        ".trivyignore",
        ".semgrepignore",
        "CODEOWNERS",
        "compose.yaml",
        "compose.yml",
        "compose.override.yaml",
        "compose.override.yml"
      ],
      "contains": [
        "auth",
        "tenancy",
        "billing",
        "credits",
        "entitlements",
        "publish",
        "tsconfig",
        "vitest.config",
        "dockerfile",
        "docker-compose"
      ],
      "suffixes": [".tf", ".tfvars"]
    },
    "tests": {
      "prefixes": [
        "packages/*/test/",
        "packages/*/tests/",
        "packages/*/__tests__/",
        "packages/*/e2e/",
        "apps/*/test/",
        "apps/*/tests/",
        "apps/*/__tests__/",
        "apps/*/e2e/",
        "templates/*/test/",
        "templates/*/tests/",
        "templates/*/__tests__/",
        "templates/*/e2e/"
      ],
      "names": [],
      "contains": [],
      "suffixes": [
        ".test.ts",
        ".test.tsx",
        ".test.js",
        ".test.mjs",
        ".test-d.ts",
        ".spec.ts",
        ".spec.tsx"
      ]
    },
    "ui": {
      "prefixes": [
        "apps/",
        "packages/ui/",
        "packages/email/",
        "packages/editor/",
        "packages/site/"
      ],
      "names": [],
      "contains": [],
      "suffixes": [".tsx", ".jsx", ".css", ".scss", ".svg", ".html", ".mdx"]
    },
    "docs": {
      "prefixes": [],
      "names": [],
      "contains": [],
      "suffixes": [".md"]
    }
  }
}
