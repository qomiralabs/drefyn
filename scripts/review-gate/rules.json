{
  "reviewers": {
    "code-reviewer": ["Divine572"],
    "qa-verifier": ["Divine572"],
    "security-reviewer": ["Divine572"],
    "performance-reviewer": ["Divine572"],
    "design-reviewer": ["Divine572"]
  },
  "paths": {
    "security": {
      "prefixes": [".github/", "scripts/", "deploy/", "docker/", ".changeset/", "packages/egress/"],
      "names": [
        "renovate.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "SECURITY.md",
        ".npmrc",
        ".nvmrc",
        ".pnpmfile.cjs",
        "turbo.json",
        "eslint.config.js",
        "eslint.config.mjs",
        "eslint.config.cjs",
        "eslint.config.ts",
        "eslint.config.mts",
        "eslint.config.cts",
        "guard.config.js",
        ".gitmodules",
        ".gitattributes",
        ".gitignore",
        "LICENSE",
        "vitest.shared.ts",
        ".prettierrc.json",
        ".prettierignore",
        "Dockerfile",
        ".dockerignore"
      ],
      "contains": ["auth", "tenancy", "billing", "credits", "entitlements", "publish", "tsconfig"],
      "suffixes": [],
      "dirs": []
    },
    "tests": {
      "prefixes": [],
      "names": [],
      "contains": [],
      "suffixes": [
        ".test.ts",
        ".test.tsx",
        ".test.js",
        ".test.mjs",
        ".test-d.ts",
        ".spec.ts",
        ".spec.tsx"
      ],
      "dirs": ["test", "tests", "__tests__", "e2e"]
    },
    "ui": {
      "prefixes": [
        "apps/",
        "packages/ui/",
        "packages/email/",
        "packages/editor/",
        "packages/site/"
      ],
      "names": [],
      "contains": [],
      "suffixes": [".tsx", ".jsx", ".css", ".scss", ".svg", ".html", ".mdx"],
      "dirs": []
    },
    "docs": {
      "prefixes": ["docs/"],
      "names": [],
      "contains": [],
      "suffixes": [".md"],
      "dirs": []
    }
  }
}
