{
  "reviewers": {
    "code-reviewer": ["Divine572"],
    "qa-verifier": ["Divine572"],
    "hygiene-auditor": ["Divine572"],
    "security-reviewer": ["Divine572"],
    "performance-reviewer": ["Divine572"],
    "design-reviewer": ["Divine572"]
  },
  "rules": [
    {
      "reviewer": "security-reviewer",
      "prefixes": [".github/", "scripts/", "deploy/", "packages/egress/"],
      "names": [
        "renovate.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "SECURITY.md",
        ".npmrc",
        ".nvmrc",
        ".pnpmfile.cjs",
        "turbo.json",
        "eslint.config.js",
        "eslint.config.mjs",
        "eslint.config.cjs",
        "eslint.config.ts",
        "eslint.config.mts",
        "eslint.config.cts",
        "guard.config.js",
        ".gitmodules",
        ".gitattributes",
        ".gitignore",
        "LICENSE",
        "vitest.shared.ts",
        ".prettierrc.json",
        ".prettierignore"
      ],
      "contains": ["auth", "tenancy", "billing", "credits", "entitlements", "tsconfig"]
    }
  ]
}
