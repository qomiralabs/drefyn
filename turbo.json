{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/lint-rules/src/**"
      ],
      "outputs": []
    },
    "test": {
      "env": ["DREFYN_RELEASE_FLAGS"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#format:check": {
      "cache": false
    },
    "@drefyn/lint-rules#test": {
      "env": ["DREFYN_RELEASE_FLAGS"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/*.tsbuildinfo",
        "!$TURBO_ROOT$/.git",
        "!$TURBO_ROOT$/.git/**",
        "!$TURBO_ROOT$/.internal/**"
      ]
    }
  }
}
