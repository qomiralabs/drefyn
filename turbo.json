{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "env": ["DREFYN_RELEASE_FLAGS"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#format:check": {
      "cache": false
    }
  }
}
