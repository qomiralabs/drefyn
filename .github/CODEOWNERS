# Changes to the gates, the build and install config, the supply chain and the security
# policy need a maintainer's review, since a PR can otherwise rewrite the checks that
# judge it.
/.github/                  @Divine572
/scripts/                  @Divine572
/deploy/                   @Divine572
/.gitignore                @Divine572
/LICENSE                   @Divine572
/renovate.json             @Divine572
/SECURITY.md               @Divine572
/package.json              @Divine572
/pnpm-lock.yaml            @Divine572
/pnpm-workspace.yaml       @Divine572
/.npmrc                    @Divine572
/.nvmrc                    @Divine572
/.pnpmfile.cjs             @Divine572
/turbo.json                @Divine572
/tsconfig*.json            @Divine572
/eslint.config.js          @Divine572
# A nested ESLint config drops the boundary rules for its folder.
**/eslint.config.*         @Divine572
/scripts/lint-rules/guard.config.js @Divine572
# Everything here may open raw network connections, so every change is a security change.
/packages/egress/          @Divine572
# Migrations set grants, policies and row level security, so every change is a security change.
/packages/db/migrations/   @Divine572
/vitest.shared.ts          @Divine572
/.prettierrc.json          @Divine572
/.prettierignore           @Divine572
# Submodules and attributes change what git lists, and so what the guard lints.
**/.gitmodules             @Divine572
**/.gitattributes          @Divine572
