# A list of what goes in, so a new file at the root never ends up in the image by accident.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!scripts/patches
!apps/api/package.json
!apps/api/server.ts
!apps/api/src
!packages/address/package.json
!packages/address/src
!packages/auth/package.json
!packages/auth/src
!packages/auth/data
!packages/db/package.json
!packages/db/src
!packages/entitlements/package.json
!packages/entitlements/src
!packages/flags/package.json
!packages/flags/src
!packages/retrieval/package.json
!packages/retrieval/src
!packages/seal/package.json
!packages/seal/src
!packages/tenancy/package.json
!packages/tenancy/src
!deploy/api/entrypoint.sh
