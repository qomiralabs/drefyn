# Copy to deploy/.env, or let scripts/selfhost.sh up generate it with random passwords.
# deploy/.env is gitignored; keep it mode 600. Leave a value empty and the stack refuses to
# initialise. Passwords are set once, on the first start; see deploy/README.md to change one.

# Names this stack's data volume, so the scripts can tell it from a volume another checkout
# or an older stack left under the same project name. Any random value; up generates one.
# Not a secret, but never change it after the first start and never copy it to another
# checkout: newer Compose offers to recreate a volume whose label changed, deleting the data.
DREFYN_STACK_ID=

# Superuser. Used only by the one time bootstrap; operators reach the superuser over the
# peer socket with docker compose exec. At least 16 characters.
DREFYN_POSTGRES_PASSWORD=

# Migration owner, application and public reader roles. At least 16 characters each.
DREFYN_OWNER_PASSWORD=
DREFYN_APP_PASSWORD=
DREFYN_PUBLIC_READER_PASSWORD=

# Sign in role, which reads identity tables only. At least 16 characters. A deploy/.env from
# before this role gets one generated by scripts/selfhost.sh up or upgrade.
DREFYN_AUTH_PASSWORD=

# Dashboard auth keys, each exactly 32 random bytes in unpadded base64url (43 characters).
# scripts/selfhost.sh up generates them once and never prints them; see deploy/README.md
# before changing one. The dashboard refuses to start without them.
# Signs codes, rate limit keys and form tokens. Rotate with DREFYN_AUTH_SECRET_PREVIOUS.
DREFYN_AUTH_SECRET=
# Keys the "I did not expect this" invitation blocks. Never rotated: a new value lifts every
# block, because blocks are stored as an HMAC of the address under this key.
DREFYN_AUTH_INVITATION_BLOCK_KEY=
# The API service's failure limiter. Rotating it only resets API key failure windows.
DREFYN_API_RATE_LIMIT_KEY=

# Host port for Postgres, always bound to 127.0.0.1.
DREFYN_POSTGRES_PORT=55432

# Memory limit for the Postgres container.
# DREFYN_POSTGRES_MEMORY_LIMIT=1g

# Set this to run a second stack beside the first one on the same machine.
# COMPOSE_PROJECT_NAME=drefyn
