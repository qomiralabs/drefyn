{
  "name": "@drefyn/engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bench": "node bench/chunk.ts && node bench/save.ts"
  },
  "dependencies": {
    "@drefyn/db": "workspace:*",
    "@drefyn/entitlements": "workspace:*",
    "@drefyn/flags": "workspace:*",
    "@drefyn/mdx": "workspace:*",
    "@drefyn/tenancy": "workspace:*",
    "kysely": "0.29.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
