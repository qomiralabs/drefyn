{
  "name": "@drefyn/mdx",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "test:fuzz": "node fuzz/run.ts",
    "test:merge": "MERGE_PROPERTY_RUNS=100000 vitest run test/merge3.property.test.ts",
    "test:mutation": "stryker run",
    "bench": "node bench/roundtrip.ts",
    "pin:ast": "node test/pin-ast.ts"
  },
  "dependencies": {
    "@drefyn/tenancy": "workspace:*",
    "@types/mdast": "4.0.4",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/estree": "1.0.9",
    "@types/hast": "3.0.4",
    "fast-check": "4.10.2",
    "hast-util-to-html": "9.0.5",
    "mdast-util-to-hast": "13.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
