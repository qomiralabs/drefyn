{
  "name": "@drefyn/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "drefyn": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:types": "node src/check-types.ts"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3"
  }
}
