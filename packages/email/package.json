{
  "name": "@drefyn/email",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./config": "./src/config.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "preview": "vitest run --config vitest.tools.config.ts tools/preview",
    "bench": "vitest run --config vitest.tools.config.ts tools/bench"
  },
  "dependencies": {
    "@drefyn/address": "workspace:*",
    "@drefyn/tenancy": "workspace:*",
    "@drefyn/ui": "workspace:*",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3"
  }
}
