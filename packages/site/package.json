    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@drefyn/tenancy": "workspace:*",
    "@drefyn/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3"
  }
}
