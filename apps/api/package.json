{
  "name": "@drefyn/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@drefyn/auth": "workspace:*",
    "@drefyn/db": "workspace:*",
    "@drefyn/entitlements": "workspace:*",
    "@drefyn/flags": "workspace:*",
    "@drefyn/tenancy": "workspace:*",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "6.0.3"
  }
}
