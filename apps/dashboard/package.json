{
  "name": "@drefyn/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "node server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "bench:wrapper": "node bench/wrapper.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:e2e": "playwright test --project=shell-chromium --project=shell-firefox --project=shell-webkit --project=flag-off --project=axe --project=reduced-motion --project=bundle --project=inp --project=lighthouse --project=auth --project=auth-no-js --project=auth-hop",
    "test:visual": "playwright test --project=visual",
    "seed:e2e": "node e2e/seed.ts"
  },
  "dependencies": {
    "@drefyn/address": "workspace:*",
    "@drefyn/auth": "workspace:*",
    "@drefyn/db": "workspace:*",
    "@drefyn/email": "workspace:*",
    "@drefyn/entitlements": "workspace:*",
    "@drefyn/flags": "workspace:*",
    "@drefyn/tenancy": "workspace:*",
    "@drefyn/ui": "workspace:*",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "kysely": "0.29.7",
    "lighthouse": "13.6.0",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "web-vitals": "6.2.3"
  }
}
