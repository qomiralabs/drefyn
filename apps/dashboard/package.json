{
  "name": "@drefyn/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test --project=shell-chromium --project=shell-firefox --project=shell-webkit --project=flag-off --project=axe --project=reduced-motion --project=bundle",
    "test:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "@drefyn/flags": "workspace:*",
    "@drefyn/ui": "workspace:*",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3"
  }
}
